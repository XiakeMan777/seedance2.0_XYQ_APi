# 小云雀 Web API 环境变量示例
# 复制为 .env 后按需修改；.env 不会进入 git，请勿在此提交真实凭证。

# ---- 服务监听 ----
# 服务无鉴权，务必保持回环地址，不要暴露到公网
HOST=127.0.0.1
PORT=8033
MAX_WORKERS=1

# ---- 浏览器接入（外部浏览器模式，默认）----
# 连接本机已运行、已登录的小云雀 Chrome 的 CDP 端点。
# 该模式下不读取/不上传任何 Cookie，账号即浏览器里当前登录的账号。
BROWSER_CDP_URL=http://127.0.0.1:18800

# 是否允许在连接失败时另起一个独立 Chromium（默认 false，失败即明确报错）
ALLOW_BROWSER_LAUNCH=false

# ---- 独立部署模式（可选，需要 ALLOW_BROWSER_LAUNCH 与 Cookie 文件）----
# 清空 BROWSER_CDP_URL 并设置 ALLOW_BROWSER_LAUNCH=true 才会启用旧的 Cookie 文件模式
# COOKIES_DIR=./cookies

# ---- 超时与调试 ----
# 单任务最大执行时间（秒）。Seedance 高峰期普通队列等待可能远超 20 分钟，
# 若沿用 1200，排队中的任务会被本地判为 failed（上游其实还在排队）。
# 建议高峰/长视频场景设为 7200-10800。
# TASK_TIMEOUT=10800
# ACCOUNT_CHECK_TIMEOUT=90
# DEBUG_MODE=false
# HEADLESS=true
